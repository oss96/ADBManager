{
  "meta": {
    "name": "ADB Manager design tokens",
    "version": 1,
    "note": "Hand-maintained. Platform constants live in apps/*/ and must match these values."
  },
  "color": {
    "accent":           { "light": "#0F7B6C", "dark": "#3DD6B5" },
    "onAccent":         { "light": "#FFFFFF", "dark": "#062B25" },
    "accentSubtle":     { "light": "#E3F4F0", "dark": "#123A33" },
    "bg":               { "light": "#F4F7F6", "dark": "#121817" },
    "surface":          { "light": "#FFFFFF", "dark": "#1B2322" },
    "border":           { "light": "#D3DDDB", "dark": "#2D3A38" },
    "text":             { "light": "#15201E", "dark": "#E4ECEA" },
    "textSecondary":    { "light": "#52615E", "dark": "#98A9A6" },
    "state": {
      "online":    { "fg": { "light": "#1A7336", "dark": "#6BD68B" }, "bg": { "light": "#E2F3E6", "dark": "#173222" } },
      "attention": { "fg": { "light": "#8A5A00", "dark": "#F2C14E" }, "bg": { "light": "#FBF0D9", "dark": "#3A2E12" } },
      "muted":     { "fg": { "light": "#5B6765", "dark": "#A3B0AE" }, "bg": { "light": "#ECEFEE", "dark": "#262E2D" } },
      "recovery":  { "fg": { "light": "#7443C9", "dark": "#C4A6FF" }, "bg": { "light": "#EFE8FB", "dark": "#2C2342" } },
      "fastboot":  { "fg": { "light": "#1F5FBF", "dark": "#8DB8FF" }, "bg": { "light": "#E4EDFB", "dark": "#1B2A44" } },
      "error":     { "fg": { "light": "#B42318", "dark": "#FF8A80" }, "bg": { "light": "#FCE8E6", "dark": "#3D1D1B" } }
    }
  },
  "space":  { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "radius": { "chip": 999, "control": 6, "panel": 10 },
  "rowHeight": { "macos": 32, "windows": 40, "linux": 44 },
  "window": { "minWidth": 900, "minHeight": 560, "inspectorCollapseBelow": 1100 },
  "type": {
    "note": "Families are platform-native. Sizes are points on the platform's own scale.",
    "ui":   { "macos": "SF Pro", "windows": "Segoe UI Variable", "linux": "Cantarell / Adwaita Sans" },
    "mono": { "macos": "SF Mono", "windows": "Cascadia Mono", "linux": "Monospace" },
    "scale": { "caption": 11, "body": 13, "bodyWindows": 14, "title": 17, "largeTitle": 22 }
  }
}
