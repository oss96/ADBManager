<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives AppState against the real Rust core and a fake adb server.
       Run with the port of a fake adb server as the only argument, adbm_ffi on the library path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdbManager.Core\AdbManager.Core.csproj" />
  </ItemGroup>
</Project>
